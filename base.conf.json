{
    "description": "Base repositories for bitbake build",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.8",
                "rev": "2.8"
            },
            "path": "bitbake"
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "06dd66e6220e5ce4ed4b9af4d8231ae5f0a8ce80"
            }
        },
        "meta-yocto": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "8251bdad5fda780a000fb41e6eda82eadf0fa39e"
        },
        "meta-haridwar": {
            "uri": "https://github.com/kshitij9192/meta-haridwar",
            "branch": "main",
            "rev": "main"
        },
        "meta-ti": {
                "uri": "https://git.yoctoproject.org/meta-ti",
                "branch": "wrynose",
                "rev": "50756d15542f9c2e528f3ffcecd48d0adb4fee68"
        },
        "meta-arm": {
            "uri": "https://git.yoctoproject.org/meta-arm",
            "branch": "wrynose",
            "rev": "d3b55902fb9963978be90d6f283296de456b4b63"
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "haridwarconf",
                "description": "Bitbake setup for Haridwar",
                "setup-dir-name": "build-$machine",
                "bb-layers": ["openembedded-core/meta", "meta-haridwar"],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {"name": "machine/haridwar-board", "description": "Haridwar Embedded Board"}
                        ]
                    },
                    "distro": {
                        "description": "Target Distributions",
                        "options": [
                            {"name": "kkdistro", "description": "KK Distro for embedded systems"}
                        ]
                    }
                }
            }
        ]
    }
}